# Copy to apps/api/.env and apps/web/.env (setup.sh does this).

# Owner connection: Prisma CLI (migrations) and seed. Bypasses RLS.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# App runtime connection: pulse_app role, subject to row-level security.
APP_DATABASE_URL="postgresql://pulse_app:pulse_app@localhost:5432/pulse"

PORT=3001
JWT_SECRET="local-dev-only-change-me"
JWT_TTL_SECONDS=86400

# Per-IP fixed windows (milliseconds). Login uses the tighter bucket.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=10

# Web
VITE_API_URL="http://localhost:3001"

{
  "info": {
    "name": "Pulse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('health 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "TRACE not allowed",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('405 or 404', () => pm.expect([404, 405]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "TRACE",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Validation envelope",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));",
              "const body = pm.response.json();",
              "pm.test('code', () => pm.expect(body.error.code).to.eql('VALIDATION_FAILED'));",
              "pm.test('no internals', () => pm.expect(JSON.stringify(body)).to.not.match(/stack|prisma|SELECT/i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"not-an-email\", \"extra\": \"x\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login Liam",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('token', body.token);",
              "pm.environment.set('liamToken', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{liamEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Active survey",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('active 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{liamToken}}" }],
        "url": "{{baseUrl}}/surveys/active"
      }
    },
    {
      "name": "Member cannot create survey",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('403', () => pm.response.to.have.status(403));",
              "pm.test('code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN_PERMISSION'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{liamToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"title\": \"Nope\", \"questions\": [{ \"text\": \"x\", \"type\": \"RATING\", \"position\": 1 }] }"
        },
        "url": "{{baseUrl}}/surveys"
      }
    },
    {
      "name": "Login Nora",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('noraToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{noraEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Submit pulse",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('submit 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('responseId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{noraToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{nw1}}\", \"ratingValue\": 4 },\n    { \"questionId\": \"{{nw2}}\", \"yesNoValue\": true }\n  ]\n}"
        },
        "url": "{{baseUrl}}/surveys/{{northwindSurvey}}/responses"
      }
    },
    {
      "name": "Submit pulse replay",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('idempotent 201', () => pm.response.to.have.status(201));",
              "pm.test('same row', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('responseId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{noraToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{nw1}}\", \"ratingValue\": 4 },\n    { \"questionId\": \"{{nw2}}\", \"yesNoValue\": true }\n  ]\n}"
        },
        "url": "{{baseUrl}}/surveys/{{northwindSurvey}}/responses"
      }
    },
    {
      "name": "Login Maya",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "const token = pm.response.json().token;",
              "pm.environment.set('token', token);",
              "pm.environment.set('mayaToken', token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{mayaEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Northwind summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('summary 200', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mayaToken}}" }],
        "url": "{{baseUrl}}/surveys/{{northwindSurvey}}/summary"
      }
    },
    {
      "name": "Cross-org survey hidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('code', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mayaToken}}" }],
        "url": "{{baseUrl}}/surveys/{{apexSurvey}}/summary"
      }
    },
    {
      "name": "Activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('activity 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('paged', () => { pm.expect(body.items).to.be.an('array'); pm.expect(body.limit).to.be.at.most(100); });",
              "const raw = pm.response.text();",
              "pm.test('no secrets', () => pm.expect(raw).to.not.match(/tokenHash|Bearer |@northwind/));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mayaToken}}" }],
        "url": "{{baseUrl}}/activity?group=surveys"
      }
    },
    {
      "name": "Logout Maya",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('logout 201', () => pm.response.to.have.status(201));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{mayaToken}}" }],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "Revoked Maya token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('revoked', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_TOKEN_REVOKED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mayaToken}}" }],
        "url": "{{baseUrl}}/surveys/active"
      }
    },
    {
      "name": "Login Priya module denied",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{priyaEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Apex summary denied",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('module denied', () => pm.response.to.have.status(403));",
              "pm.test('code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN_MODULE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/surveys/{{apexSurvey}}/summary"
      }
    },
    {
      "name": "Login Owen first",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('owenToken', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{owenEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login Owen second",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('login 201', () => pm.response.to.have.status(201));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{owenEmail}}\", \"password\": \"{{password}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "First Owen token revoked",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('revoked', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_TOKEN_REVOKED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{owenToken}}" }],
        "url": "{{baseUrl}}/surveys/active"
      }
    }
  ]
}

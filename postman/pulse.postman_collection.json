{
  "info": {
    "name": "Pulse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login Liam",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"userId\": \"{{liamId}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Active survey",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/surveys/active"
      }
    },
    {
      "name": "Submit pulse",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    { \"questionId\": \"{{nw1}}\", \"ratingValue\": 4 },\n    { \"questionId\": \"{{nw2}}\", \"yesNoValue\": true }\n  ]\n}"
        },
        "url": "{{baseUrl}}/surveys/{{northwindSurvey}}/responses"
      }
    },
    {
      "name": "Login Maya",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"userId\": \"{{mayaId}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Northwind summary",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/surveys/{{northwindSurvey}}/summary"
      }
    },
    {
      "name": "Activity",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/activity"
      }
    },
    {
      "name": "Login Priya module denied",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"userId\": \"{{priyaId}}\" }"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Apex summary denied",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('module denied', () => pm.response.to.have.status(403));",
              "pm.test('code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN_MODULE'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/surveys/{{apexSurvey}}/summary"
      }
    }
  ]
}
